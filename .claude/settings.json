{
  "permissions": {
    "allow": [
      "Bash(git config *)",
      "Bash(git checkout *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PROJECT_DIR:-.}/memory/MEMORY.md\" | jq -Rs '{hookSpecificOutput:{hookEventName:\"UserPromptSubmit\",additionalContext:.}}' 2>/dev/null || true",
            "statusMessage": "Carregando memória..."
          }
        ]
      }
    ]
  }
}
